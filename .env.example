# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=christmas_lights
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/christmas_lights?schema=public"

# Authentication secrets
JWT_ACCESS_SECRET="super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"

# Frontend origin (for CORS)
FRONTEND_ORIGIN="http://localhost:5173"

# Node Environment
NODE_ENV="development"
PORT=3000
