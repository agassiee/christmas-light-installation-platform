// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
}

enum JobType {
  INSTALLATION
  REMOVAL
  MAINTENANCE
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventType {
  STATUS_CHANGE
  RESCHEDULE
}

enum AssignmentStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum PhotoType {
  BEFORE
  AFTER
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         Role
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  RefreshToken RefreshToken[]
  Worker       Worker?
  JobNotes     JobNote[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id              String     @id @default(uuid())
  fullName        String
  phone           String
  email           String?
  notes           String?
  whatsappOptIn   Boolean    @default(false)
  whatsappOptInAt DateTime?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  Properties      Property[]

  @@index([phone])
}

model Property {
  id             String          @id @default(uuid())
  customerId     String
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String
  latitude       Float?
  longitude      Float?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       Customer        @relation(fields: [customerId], references: [id])
  ServiceSeasons ServiceSeason[]
  Jobs           Job[]

  @@index([customerId])
}

model ServiceSeason {
  id          String   @id @default(uuid())
  propertyId  String
  seasonLabel String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id])
  Jobs        Job[]

  @@unique([propertyId, seasonLabel])
  @@index([propertyId])
}

model Worker {
  id             String          @id @default(uuid())
  userId         String          @unique
  fullName       String
  phone          String
  email          String?
  skills         String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  JobAssignments JobAssignment[]
}

model Job {
  id                       String             @id @default(uuid())
  propertyId               String
  serviceSeasonId          String
  type                     JobType
  status                   JobStatus
  scheduledDate            DateTime
  scheduledStartTime       String? // e.g. "09:00"
  estimatedDurationMinutes Int?
  instructions             String?
  equipmentNotes           String?
  cancellationReason       String?
  completedAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  property                 Property           @relation(fields: [propertyId], references: [id])
  serviceSeason            ServiceSeason      @relation(fields: [serviceSeasonId], references: [id])
  Assignments              JobAssignment[]
  StatusHistory            JobStatusHistory[]
  Notes                    JobNote[]
  Photos                   JobPhoto[]

  @@index([propertyId])
  @@index([serviceSeasonId])
  @@index([status])
  @@index([scheduledDate])
}

model JobAssignment {
  id          String           @id @default(uuid())
  jobId       String
  workerId    String
  isLead      Boolean          @default(false)
  status      AssignmentStatus @default(INVITED)
  invitedAt   DateTime         @default(now())
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  job         Job              @relation(fields: [jobId], references: [id])
  worker      Worker           @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
}

model JobStatusHistory {
  id                    String     @id @default(uuid())
  jobId                 String
  eventType             EventType
  oldStatus             JobStatus?
  newStatus             JobStatus?
  oldScheduledDate      DateTime?
  newScheduledDate      DateTime?
  oldScheduledStartTime String?
  newScheduledStartTime String?
  reason                String?
  actorUserId           String
  createdAt             DateTime   @default(now())
  job                   Job        @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model JobNote {
  id        String   @id @default(uuid())
  jobId     String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([jobId])
}

model JobPhoto {
  id               String    @id @default(uuid())
  jobId            String
  uploadedByUserId String
  type             PhotoType
  storageKey       String
  url              String?
  createdAt        DateTime  @default(now())
  job              Job       @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
}

model Notification {
  id                String              @id @default(uuid())
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  payload           Json
  idempotencyKey    String              @unique
  providerMessageId String?
  attempts          Int                 @default(0)
  lastError         String?
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  DeliveryEvents    NotificationDeliveryEvent[]

  @@index([status])
}

model NotificationDeliveryEvent {
  id                String       @id @default(uuid())
  notificationId    String
  providerMessageId String
  eventType         String
  eventKey          String       @unique
  receivedAt        DateTime     @default(now())
  notification      Notification @relation(fields: [notificationId], references: [id])
  
  @@index([providerMessageId])
}
